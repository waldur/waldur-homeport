{
  "name": "waldur-micro-app-poc",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone proof-of-concept consumer of packages/* — proves each extracted package is genuinely portable outside waldur-homeport's own src/, not just importable via workspace hoisting.",
  "type": "module",
  "waldur": {
    "deploy": false,
    "title": "Workspace modes preview",
    "description": "A preview of role-based workspaces built on the shared app shell.",
    "visibleTo": {
      "staffOnly": true
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:subpath": "DEV_SUBPATH=1 vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "@sentry/react": "^8.55.0",
    "@tanstack/react-query": "^5.80.6",
    "final-form": "^4.20.10",
    "final-form-calculate": "1.3.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-final-form": "^6.5.9",
    "react-redux": "^8.0.0",
    "redux": "^4.2.1",
    "waldur-api-client": "workspace:*",
    "waldur-boot-splash": "workspace:*",
    "waldur-design-tokens": "workspace:*",
    "waldur-form": "workspace:*",
    "waldur-i18n-runtime": "workspace:*",
    "waldur-notifications": "workspace:*",
    "waldur-shell": "workspace:*",
    "waldur-table": "workspace:*",
    "waldur-ui": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^8.0.16"
  }
}
