{
  "name": "waldur-provider-calls",
  "version": "0.0.0",
  "private": true,
  "description": "Proof of concept: a service provider's work in calls for proposals (offering requests, the offering team's assessments, proposals and demand) as a standalone micro-app.",
  "type": "module",
  "waldur": {
    "deploy": false,
    "title": "Calls for providers",
    "description": "Requests from calls, your team's assessments, awards and demand.",
    "visibleTo": {
      "features": [
        "marketplace.show_call_management_functionality"
      ],
      "roles": [
        "OFFERING.MANAGER",
        "OFFERING.EVALUATOR"
      ]
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:subpath": "DEV_SUBPATH=1 vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "@tanstack/react-query": "^5.80.6",
    "final-form": "^4.20.10",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-final-form": "^6.5.9",
    "waldur-api-client": "workspace:*",
    "waldur-boot-splash": "workspace:*",
    "waldur-design-tokens": "workspace:*",
    "waldur-form": "workspace:*",
    "waldur-i18n-runtime": "workspace:*",
    "waldur-notifications": "workspace:*",
    "waldur-proposals": "workspace:*",
    "waldur-shell": "workspace:*",
    "waldur-ui": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^8.0.16"
  }
}
