{
  "name": "waldur-homeport",
  "version": "4.8.6",
  "description": "Web interface for Waldur MasterMind cloud orchestrator",
  "repository": "https://github.com/waldur/waldur-homeport",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "husky",
    "start": "VITE_API_URL=http://localhost:8000/ vite --port 8001",
    "devcontainer": "VITE_API_URL=http://localhost:8000/ vite --host 0.0.0.0 --port 8001",
    "build": "NODE_OPTIONS=--max-old-space-size=32768 vite build",
    "preview": "vite preview",
    "format:check": "prettier --check \"src/**/*.ts\" \"src/**/*.tsx\" \"src/**/*.css\" \"src/**/*.scss\"",
    "format:fix": "prettier --write \"src/**/*.ts\" \"src/**/*.tsx\" \"src/**/*.css\" \"src/**/*.scss\"",
    "style:check": "stylelint \"src/**/*.css\" \"src/**/*.scss\"",
    "lint:check": "eslint src locales/tools",
    "lint:fix": "eslint --fix src locales/tools",
    "deps:unused": "knip --include files,types,enumMembers,exports",
    "deps:circular": "madge --exclude 'broadcasts/BroadcastFooter' --exclude 'js-client' --circular src/**/*",
    "test": "vitest",
    "test:e2e": "playwright test --project e2e",
    "i18n:extract": "node locales/tools/extractLiteralsFromFiles.cjs",
    "i18n:check": "node locales/tools/checkTranslations.cjs",
    "i18n:check:dry": "node locales/tools/checkTranslations.cjs --dry-run",
    "i18n:check:locales": "node locales/tools/checkTranslations.cjs --locales-only",
    "i18n:check:lang": "node locales/tools/checkTranslations.cjs --language",
    "i18n:clean": "node locales/tools/removeDeprecatedTranslations.cjs",
    "i18n:validate": "node locales/tools/validateTranslations.cjs",
    "i18n:analyze": "node locales/tools/analyzeLanguageTranslations.cjs",
    "i18n:llm:prepare": "node locales/tools/simpleLLMProcessor.cjs",
    "i18n:search": "node locales/tools/searchTranslations.cjs",
    "i18n:analyze-changes": "node locales/tools/analyzeTranslations.cjs",
    "i18n:edit": "node locales/tools/translationEdit.cjs",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.11.51",
    "@codemirror/language": "^6.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@fontsource/inter": "^4.5.15",
    "@fontsource/maven-pro": "^5.2.10",
    "@fontsource/open-sans": "^4.5.14",
    "@iconify-json/ph": "^1.2.2",
    "@jonkoops/matomo-tracker": "^0.7.0",
    "@lezer/highlight": "^1.0.0",
    "@mdxeditor/editor": "^3.52.3",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.7",
    "@popperjs/core": "~2.10.1",
    "@sentry/react": "^8.55.0",
    "@tanstack/react-query": "^5.80.6",
    "@uirouter/react": "^1.0.7",
    "attr-accept": "^2.2.5",
    "bootstrap": "5.1.3",
    "classnames": "^2.2.5",
    "dompurify": "^3.4.0",
    "echarts": "^6.0.0",
    "final-form": "^4.20.10",
    "final-form-arrays": "^3.1.0",
    "flatpickr": "^4.6.13",
    "js-yaml": "^4.1.1",
    "jszip": "3.8.0",
    "leaflet": "^1.9.4",
    "leaflet-geosearch": "^3.11.1",
    "lodash-es": "^4.18.0",
    "luxon": "3.2.1",
    "markdown-to-jsx": "^7.7.4",
    "marked": "^18.0.0",
    "mermaid": "^11.12.1",
    "monaco-editor": "^0.52.2",
    "papaparse": "^5.2.2",
    "pdfmake": "^0.2.18",
    "qs": "^6.14.2",
    "react": "^18.3.0",
    "react-bootstrap": "^2.10.9",
    "react-dom": "^18.3.0",
    "react-dropzone": "^14.3.5",
    "react-final-form": "^6.5.9",
    "react-final-form-arrays": "^3.1.4",
    "react-flatpickr": "^3.10.13",
    "react-leaflet": "^4.2.1",
    "react-redux": "^8.0.0",
    "react-responsive": "^10.0.0",
    "react-select": "^5.10.0",
    "react-select-async-paginate": "^0.7.9",
    "react-ultimate-pagination": "^1.3.2",
    "react-use": "^17.6.0",
    "react-window": "^1.8.11",
    "react-window-paginated": "^1.0.0",
    "react-windowed-select": "^5.2.0",
    "reapop": "^4.2.2",
    "redux": "^4.2.1",
    "redux-form": "^8.3.10",
    "redux-thunk": "^2.4.2",
    "reselect": "^3.0.1",
    "text-security": "^3.2.1",
    "waldur-js-client": "8.0.8-dev.28",
    "yjs": "^13.5.22"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@playwright/test": "^1.58.0",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/js-yaml": "^4.0.9",
    "@types/leaflet": "^1.5.19",
    "@types/leaflet-geosearch": "^2.7.1",
    "@types/lodash-es": "^4.17.12",
    "@types/luxon": "^2.0.4",
    "@types/node": "^20.14.6",
    "@types/qs": "^6.9.18",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-flatpickr": "^3.8.6",
    "@types/react-redux": "^7.1.4",
    "@types/react-ultimate-pagination": "^1.2.1",
    "@types/react-window": "^1.8.8",
    "@types/redux-form": "^8.3.10",
    "@vitejs/plugin-react": "5",
    "@vitest/coverage-v8": "3",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "cssnano": "^7.0.6",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "got": "^14.4.7",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "knip": "^6.5.0",
    "lint-staged": "^15.4.3",
    "madge": "^8.0.0",
    "mock-match-media": "^0.4.3",
    "nock": "^14.0.6",
    "oxlint": "^1.20.0",
    "postcss": "^8.5.10",
    "postcss-import": "^14.1.0",
    "prettier": "^3.6.2",
    "read-excel-file": "^7.0.1",
    "redux-logger": "^3.0.6",
    "redux-mock-store": "^1.2.3",
    "sass": "^1.85.0",
    "serve": "^14.2.4",
    "source-map": "^0.7.6",
    "stylelint": "^16.14.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "ts-import-plugin": "^3.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "7.3.2",
    "vite-plugin-markdown": "^2.2.0",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "3",
    "vitest-location-mock": "^1.0.4"
  },
  "prettier": {
    "semi": true,
    "trailingComma": "all",
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2
  },
  "lint-staged": {
    "**/*.js": [
      "yarn prettier --write"
    ],
    "**/*.{ts,tsx}": [
      "yarn eslint --fix"
    ],
    "**/*.{css,scss}": [
      "yarn prettier --write"
    ]
  },
  "knip": {
    "eslint": {
      "entry": [
        "eslint.config.js"
      ]
    },
    "ignore": [
      "src/metronic/**",
      "src/EventsEnums.ts",
      "locales/tools/*.cjs",
      "src/sass/mediaqueries.scss",
      "src/sass/variables.scss",
      "generate-filters.cjs",
      "src/table/generated/*.tsx"
    ]
  },
  "stylelint": {
    "extends": "stylelint-config-recommended-scss",
    "ignoreFiles": [
      "./src/metronic/**/*.scss"
    ],
    "rules": {
      "no-descending-specificity": null,
      "scss/load-no-partial-leading-underscore": null
    }
  },
  "jscpd": {
    "ignore": [
      "src/form/BoxNumberField.scss",
      "src/metronic/sass/core/components/buttons/_theme.scss",
      "src/metronic/sass/core/base/functions/_get.scss",
      "src/table/generated/ProposalProposalsFilter.tsx",
      "src/table/generated/MarketplaceStatsOpenstackInstancesFilter.tsx"
    ]
  },
  "resolutions": {
    "systeminformation": "^5.31.0",
    "lodash": "^4.18.0",
    "lodash-es": "^4.18.0",
    "qs": "^6.14.2",
    "diff": "^5.2.2",
    "**/serve-handler/**/minimatch": "^3.1.3",
    "@xmldom/xmldom": "^0.8.13",
    "flatted": "^3.4.2",
    "smol-toml": "^1.6.1",
    "dompurify": "^3.4.0",
    "sass/immutable": "^5.1.5",
    "vite": "^7.3.2",
    "serve/ajv": "^8.18.0",
    "table/ajv": "^8.18.0",
    "postcss": "^8.5.10"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
