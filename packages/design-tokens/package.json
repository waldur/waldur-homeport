{
  "name": "waldur-design-tokens",
  "version": "1.0.0",
  "private": true,
  "description": "Shared brand color-ramp generation and CSS custom-property bootstrap for Waldur frontend apps",
  "type": "module",
  "main": "src/index.ts",
  "style": "src/css/index.css",
  "exports": {
    ".": "./src/index.ts",
    "./contrast": "./src/contrast.ts",
    "./test-support/theme-tokens": "./src/themeTokens.ts",
    "./react": "./src/react.ts",
    "./index.css": "./src/css/index.css",
    "./fonts.css": "./src/css/fonts.css",
    "./primitives.css": "./src/css/primitives/index.css",
    "./semantic.css": "./src/css/semantic/index.css",
    "./components.css": "./src/css/components/index.css",
    "./primitives/*": "./src/css/primitives/*",
    "./semantic/*": "./src/css/semantic/*",
    "./components/*": "./src/css/components/*",
    "./tailwind/*": "./src/css/tailwind/*",
    "./css/*": "./src/css/*",
    "./*.css": "./src/css/*.css"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/maven-pro": "^5.2.10"
  },
  "license": "MIT"
}
