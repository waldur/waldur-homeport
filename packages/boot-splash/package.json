{
  "name": "waldur-boot-splash",
  "version": "1.0.0",
  "private": true,
  "description": "Branded boot splash shared by Waldur apps: a Vite plugin that paints it before the bundle loads, and the runtime that caches branding and dismisses it",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts",
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.js"
    }
  },
  "dependencies": {
    "waldur-api-client": "workspace:*",
    "waldur-design-tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "license": "MIT"
}
